#!/bin/sh
# githooks/pre-commit — hindsight-alpha
#
# AJOUTÉ le 25/08/2026, en comparant garde_fou.py à l'écosystème réel de
# vérification pré-commit (pre-commit.com, gitleaks, danger-js) : le trou
# le plus profond n'était pas un contrôle manquant, c'était l'absence de
# tout mécanisme forçant `garde_fou.py` à tourner. Un script qu'il faut
# PENSER à lancer à la main ne protège rien le jour où on est pressé —
# exactement le défaut qu'un garde-fou dénonce
# ailleurs sous une autre forme ("un outil qui existe mais qu'on ne lance
# pas ne sert à rien").
#
# ⚠️ Ce dossier N'EST PAS activé automatiquement par git (contrairement à
# .git/hooks/, qui n'est lui-même jamais versionné donc jamais partagé
# entre machines). Active-le une fois par clone :
#
#     git config core.hooksPath githooks
#
# Après ça, chaque `git commit` relance garde_fou.py et refuse le commit
# si le verdict est 🔴. Un verdict 🟡 n'empêche rien (par design — voir
# garde_fou.py : "publiable avec réserve" reste publiable).

# 🔴 PAS de `set -e` ici, corrigé dans la minute en testant ce hook pour de
# vrai : avec `set -e`, un `python3 garde_fou.py` qui sort en erreur (1)
# tue le script AVANT que la ligne suivante (`code=$?`) ne s'exécute — donc
# le message "COMMIT REFUSÉ" personnalisé plus bas ne s'affichait JAMAIS,
# même si le commit était bien bloqué (par accident, via le code de sortie
# brut du sous-processus). Constaté sur le premier témoin lancé.
cd "$(git rev-parse --show-toplevel)" || exit 1

# CORRIGÉ le 28/08/2026 : ce bloc sortait 0 EN SILENCE quand garde_fou.py
# était absent. Mesuré de bout en bout, dans une copie du dépôt avec les
# hooks actifs :
#
#   dépôt sain                     -> commit passe                  (juste)
#   garde_fou 🔴                   -> commit REFUSÉ                 (juste)
#   garde_fou.py supprimé          -> commit PASSE, hook MUET       (faux)
#
# Et la sortie de ce dernier cas disait, mot pour mot :
# « 1 file changed, 2629 deletions(-), delete mode garde_fou.py ».
# Le commit qui SUPPRIME le garde-fou était exactement celui que son propre
# hook laissait passer sans un mot.
#
# Pourquoi on ne BLOQUE pas ici, et c'est mesuré : 27 des 162 commits de ce
# dépôt sont antérieurs à garde_fou.py. Bloquer casserait tout travail sur
# cette partie de l'historique, pour un cas que la couche suivante attrape
# déjà -- vérifié : `python3 garde_fou.py` sans le fichier sort en code 2,
# donc la CI échoue au push. Le tort du hook n'était pas de laisser passer,
# c'était de ne rien dire.
if [ ! -f garde_fou.py ]; then
    echo ""
    echo "⚠️  garde_fou.py est ABSENT — ce commit n'a été vérifié par RIEN."
    echo "    Le hook laisse passer (27 commits de ce dépôt lui sont antérieurs),"
    echo "    mais la CI échouera au push. Si tu ne l'as pas supprimé exprès,"
    echo "    arrête-toi ici : git checkout HEAD -- garde_fou.py"
    echo ""
    exit 0
fi

python3 garde_fou.py
code=$?

if [ "$code" -eq 0 ]; then
    # ── LA SUITE DE TESTS, quand du CODE est indexé ───────────────────────
    #
    # AJOUTÉ le 28/08/2026 au soir, après avoir committé QUATRE FOIS dans la
    # journée sur une suite rouge sans m'en apercevoir. Ce hook ne lançait
    # que garde_fou.py : rien n'empêchait mécaniquement un commit sur du
    # code cassé. Une règle qu'on se rappelle ne vaut rien face à une règle
    # que l'outil applique.
    #
    # SEULEMENT si un .py -- OU docs/index.html -- est indexé. Mesuré : les
    # commits automatiques du tableau de bord ne touchent QUE
    # docs/data.json, toutes les 30 minutes ; ils ne paient jamais ce coût.
    #
    # docs/index.html AJOUTÉ le 29/08/2026, après quatre commits de suite qui
    # ne touchaient que lui. Ce fichier porte ~900 lignes de JavaScript, et
    # test_dashboard.py en extrait le <script> pour l'exécuter sous Node :
    # 73 tests portent dessus. La règle « un .py est indexé » lisait
    # l'EXTENSION, pas ce qui est testé.
    #
    # REPRODUIT dans un clone avant de corriger : on casse _sens() dans
    # docs/index.html, on n'indexe que ce fichier, et le commit PASSE --
    # alors que la suite est rouge de 4 tests sur ce même arbre.
    #
    # githooks/pre-commit AJOUTÉ dans la foulée, pour la même raison : ce
    # fichier-ci est EXÉCUTÉ par test_integration.py (dans un dépôt jetable,
    # pas relu à la recherche de mots-clés) et copié par test_agent.py. Le
    # gardien était le seul fichier testé que son propre gardien ignorait.
    #
    # data.json reste libre, exprès : c'est lui, et lui seul, que le
    # publicateur committe toutes les 30 minutes.
    #
    # COÛT MESURÉ : 70 s avec la sentinelle anti-récursion, 139 s sans. On
    # pose la sentinelle : à 139 s je contournerais le hook, et un garde
    # qu'on contourne ne garde rien. Le prix assumé est que le test
    # anti-récursion se saute ici ; il tourne entier en CI.
    #
    # CE QUE CE HOOK PROUVE, ET CE QU'IL NE PROUVE PAS : il lance la suite
    # sur l'ARBRE DE TRAVAIL, pas sur le contenu indexé. Avec des
    # modifications non indexées, un commit partiel peut donc être cassé
    # alors que l'arbre est vert. Limite réelle, énoncée plutôt que masquée
    # -- ce hook attrape « j'ai oublié de lancer les tests », pas « j'ai
    # indexé un sous-ensemble incohérent ».
    CODE_INDEXE=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.py$|^docs/index\.html$|^githooks/pre-commit$' || true)
    if [ -n "$HINDSIGHT_SKIP_TESTS" ]; then
        [ -z "$CODE_INDEXE" ] || echo "[pre-commit] HINDSIGHT_SKIP_TESTS posé — la suite n'a PAS tourné."
        exit 0
    fi
    if [ -z "$CODE_INDEXE" ]; then
        exit 0
    fi

    echo "[pre-commit] du code testé est indexé — lancement de la suite (~70 s)..."
    # Borne de temps, même raison que dans le hook du catalogue : sans elle,
    # une suite qui s'emballe gèle `git commit` sans autre issue qu'un
    # Ctrl-C. `timeout` n'existe pas de base sur macOS, d'où cette
    # surveillance à la main.
    DELAI="${HINDSIGHT_TESTS_TIMEOUT:-300}"
    _sortie=$(mktemp -t hindsight-tests 2>/dev/null) || _sortie=""
    if [ -z "$_sortie" ]; then
        _gd=$(git rev-parse --git-dir 2>/dev/null)
        if [ -n "$_gd" ] && : >"$_gd/tests-pre-commit.log" 2>/dev/null; then
            _sortie="$_gd/tests-pre-commit.log"
        else
            _sortie=/dev/null
            echo "[pre-commit] aucun fichier temporaire accessible — en cas d'échec le détail ne pourra pas être montré." >&2
        fi
    fi
    HINDSIGHT_SOUS_EXECUTION=1 python3 -m unittest discover -p "test_*.py" >"$_sortie" 2>&1 &
    _pid=$!
    _attendu=0
    while kill -0 "$_pid" 2>/dev/null && [ "$_attendu" -lt "$DELAI" ]; do
        sleep 1
        _attendu=$((_attendu + 1))
    done
    if kill -0 "$_pid" 2>/dev/null; then
        pkill -P "$_pid" 2>/dev/null
        kill -KILL "$_pid" 2>/dev/null
        wait "$_pid" 2>/dev/null
        echo ""
        echo "COMMIT REFUSÉ : la suite a dépassé ${DELAI}s et a été interrompue."
        echo "Ce n'est pas un test rouge, c'est une vérification qui n'a pas eu lieu."
        echo "Pour lever la borne : HINDSIGHT_TESTS_TIMEOUT=900 git commit ..."
        [ "$_sortie" = /dev/null ] || rm -f "$_sortie"
        exit 1
    fi
    wait "$_pid"
    _rc=$?
    if [ "$_rc" -ne 0 ]; then
        echo ""
        echo "COMMIT REFUSÉ : la suite de tests est ROUGE (code $_rc)."
        [ "$_sortie" = /dev/null ] || tail -25 "$_sortie" | sed 's/^/    /'
        echo ""
        echo "Pour committer quand même en connaissance de cause :"
        echo "  HINDSIGHT_SKIP_TESTS=1 git commit ...   (ou git commit --no-verify)"
        [ "$_sortie" = /dev/null ] || rm -f "$_sortie"
        exit 1
    fi
    echo "[pre-commit] suite verte."
    [ "$_sortie" = /dev/null ] || rm -f "$_sortie"
    exit 0
fi

# Distinguer « garde_fou a REFUSÉ » de « garde_fou n'a PAS PU tourner » --
# ajouté le 28/08 en relisant ce message. Il annonçait « verdict 🔴 ci-dessus »
# pour TOUT code non nul, y compris ceux où aucun verdict n'a été rendu :
# 127 (python3 introuvable), 2 (le script a planté avant de conclure). Envoyer
# quelqu'un chercher un verdict qui n'existe pas, c'est lui faire perdre le
# vrai diagnostic -- et c'est la même faute que celle que garde_fou.py
# dénonce ailleurs : confondre « je refuse » et « je n'ai pas pu mesurer ».
echo ""
if [ "$code" -eq 1 ]; then
    echo "COMMIT REFUSÉ par garde_fou.py (verdict 🔴 ci-dessus)."
    echo "Corrige le dossier, jamais garde_fou.py, pour faire taire ça."
else
    echo "COMMIT REFUSÉ : garde_fou.py n'a PAS PU rendre de verdict (code $code)."
    echo "Ce n'est pas un dossier refusé, c'est une vérification qui n'a pas eu lieu."
    echo "Codes usuels : 127 = python3 introuvable, 2 = le script a planté."
fi
echo "Pour committer quand même en connaissance de cause : git commit --no-verify"
exit 1
